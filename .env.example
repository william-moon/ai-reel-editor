# Copy to .env (the installer does this) and fill in. .env is never committed.
# `python -m reel_editor config set KEY VALUE` writes here for you.

# ---- Brain: Claude ----------------------------------------------------------------------------
# auto = use the `claude` CLI (Claude Code, logged in -> runs on your Claude plan) if present,
#        otherwise the API key below.  cli | api force one.
CLAUDE_MODE=auto
# Command for Claude Code (may include a wrapper script). Default: claude
CLAUDE_CLI=claude
# Needed only for API mode (e.g. Hermes Agent, servers without Claude Code). https://console.anthropic.com
ANTHROPIC_API_KEY=
MODEL_FAST=claude-sonnet-5-5
MODEL_SMART=claude-opus-5-5

# ---- B-roll ------------------------------------------------------------------------------------
# stock = Pexels + Pixabay together (free keys, recommended) | envato = your own logged-in Envato | none
BROLL_SOURCE=stock
# https://www.pexels.com/api/new/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/  (log in; your key is shown on that page)
PIXABAY_API_KEY=
# Envato only (no public download API): the editor uses its OWN browser, Google Chrome Canary with a permanent
# profile outside the repo, so the login is kept. Set up with:  python -m reel_editor browser login envato
#                                                      then:  python -m reel_editor browser install-service
BROWSER_CDP=http://127.0.0.1:9333
BROWSER_PROFILE=~/.ai-reel-editor/browser-profile
# optional: path to a browser binary (Linux has no Canary: google-chrome / chromium is used)
BROWSER_BIN=
# Plan B, only if the Canary login does not work: your Envato email + password are NOT kept in this file. They go in
# the encrypted vault (AES-256, key in your OS keychain):  python -m reel_editor vault set ENVATO_EMAIL
#                                                          python -m reel_editor vault set ENVATO_PASSWORD
# (or give them to your AI agent and it saves them there). Needs an email + password Envato login (Google/Apple sign-up? add a password
# at https://account.envato.com/reset_password first). Does not work with 2-step codes.

# ---- Storage -----------------------------------------------------------------------------------
# local = two folders on this computer | gdrive = two folders in Google Drive (via rclone)
STORAGE=gdrive
LOCAL_ROOT=~/ReelEditor
GDRIVE_REMOTE=gdrive
RAW_FOLDER=Raw Videos
FINISHED_FOLDER=Finished Videos

# ---- Speech recognition ------------------------------------------------------------------------
# auto | faster (faster-whisper, local) | openai (openai-whisper) | groq (hosted, fast on small VPS)
WHISPER_BACKEND=auto
# large-v3-turbo (best) | small (faster on weak CPUs)
WHISPER_MODEL=large-v3-turbo
LANGUAGE=en
# Optional: https://console.groq.com/keys  (only speech audio is uploaded)
GROQ_API_KEY=

# ---- Style -------------------------------------------------------------------------------------
# The rulebook every edit follows. learn-style --activate sets this to your own learned style.
STYLE_FILE=styles/default/STYLE.md

# ---- Output ------------------------------------------------------------------------------------
# auto = Apple hardware encoder on macOS, libx264 elsewhere
VIDEO_ENCODER=auto

# ---- Optional Telegram bot ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# comma-separated numeric user ids allowed to use the bot (send /start to the bot to see yours)
TELEGRAM_ALLOWED_USER_IDS=
# set to your own telegram-bot-api server for files over 20 MB, e.g. http://127.0.0.1:8081
TELEGRAM_API_BASE=https://api.telegram.org

# Telegram bot: hard time cap per edit, in minutes
EDIT_TIMEOUT_MIN=45
